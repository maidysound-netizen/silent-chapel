# Silent Chapel 환경 변수 예시
# 이 파일을 .env.local 로 복사한 뒤 '개발용' Supabase 프로젝트 값을 넣으세요.
#   cp .env.example .env.local
# 값이 비어 있으면 앱은 '혼자 머무는 모드'(멀티플레이 없음)로 실행됩니다.
#
# ⚠ 운영(Production) 프로젝트 값을 넣지 마세요.
# ⚠ service_role / secret 키는 절대 넣지 마세요. 아래 키는 브라우저에 공개되는 키입니다.

# Supabase 대시보드 → Project Settings → API (또는 Connect)
NEXT_PUBLIC_SUPABASE_URL=
# 새 형식 publishable 키(sb_publishable_...) 또는 기존 anon 키 중 하나
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# true(기본): Private 채널 + RLS 권한 정책 사용 (supabase/migrations 실행 필요)
# false: 공개 채널로 빠르게 테스트 (마이그레이션 없이 가능, 보안 약함 — 개발 전용)
NEXT_PUBLIC_REALTIME_PRIVATE=true

# 프로젝트 전체 초당 메시지 예산(무료 플랜 한도 100/s 보다 낮게). 접속자 수에 따라 전송 주기를 자동 조절
NEXT_PUBLIC_REALTIME_MSG_BUDGET=80
